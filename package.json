{
  "name": "econ-study-map",
  "version": "1.0.0",
  "description": "考研经济学学习进度地图 —— 西方经济学（高鸿业）微观+宏观 · 前置追溯 · 细分 · 多模型 AI · 历史例子 · 复盘导出",
  "main": "main.js",
  "scripts": {
    "build": "node build.js",
    "start": "node build.js && electron .",
    "dist": "node build.js && electron-builder",
    "dist:win": "node build.js && electron-builder --win"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.anse.econstudymap",
    "productName": "EconStudyMap",
    "files": ["index.html", "*.html", "main.js", "preload.js", "template.html", "build.js"],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  }
}
